# Classy Cash environment (config version 1). Copy to /etc/classycash/env, chmod 600, never commit real values.
# Full reference: docs/INTEGRATION.md
CLASSYCASH_CONFIG_VERSION=1
CLASSYCASH_ENV=prod
CLASSYCASH_ADDR=127.0.0.1:8080
CLASSYCASH_BASE_URL=https://example-8080.wykr.es
CLASSYCASH_DB_PATH=/var/lib/classycash/classycash.db
CLASSYCASH_INSTANCE_ID=replace-with-stable-instance-id
CLASSYCASH_TRUST_PROXY=1
CLASSYCASH_MEMORY_LIMIT_MB=160
# Voluntary support link (shown only to users who owe nothing). Default https://suppi.pl/mleczakm; `off` hides it.
# CLASSYCASH_SUPPORT_URL=off
# 32+ random characters (openssl rand -hex 32)
CLASSYCASH_SESSION_SECRET=
# One-time owner claim code for first-run setup; remove after the owner has claimed the instance.
CLASSYCASH_CLAIM_TOKEN=

# Outgoing mail through the authenticated HTTPS relay
CLASSYCASH_MAIL_DRIVER=relay
CLASSYCASH_MAIL_RELAY_URL=https://relay.example/send
CLASSYCASH_MAIL_RELAY_KEY=
CLASSYCASH_MAIL_FROM_NAME=Classy Cash

# Bank notifications (signed webhook from the Cloudflare Email Worker)
CLASSYCASH_BANK_MAIL_ADDRESS=bank-RANDOM@classycash.dpdns.org
CLASSYCASH_BANK_MAIL_SECRET=
CLASSYCASH_BANK_MAIL_FROM=
